<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      严格限制在 108dp 画布中心 66dp×66dp（[21,21] 到 [87,87]）安全区内
      核心图形：清透薄荷青 EMA 趋势曲线 + 错落的单日波动半透明散点
    -->

    <!-- 散点 1：左上方单日波动点（模拟由于高盐/水分引起的小幅上浮，半透明浅青） -->
    <path
        android:fillColor="#99E6FFFA"
        android:pathData="M41,27.8 A3.2,3.2 0 1 0 41,34.2 A3.2,3.2 0 1 0 41,27.8 Z" />

    <!-- 散点 2：中段小回落点（半透明浅青） -->
    <path
        android:fillColor="#80E6FFFA"
        android:pathData="M55,57.5 A2.5,2.5 0 1 0 55,62.5 A2.5,2.5 0 1 0 55,57.5 Z" />

    <!-- 散点 3：右侧近阶段波动点（半透明亮白） -->
    <path
        android:fillColor="#B2FFFFFF"
        android:pathData="M71,53.6 A3.4,3.4 0 1 0 71,60.4 A3.4,3.4 0 1 0 71,53.6 Z" />

    <!-- 核心：优雅从左上平滑下降至右下的 EMA 指数移动平均趋势线 -->
    <path
        android:pathData="M33,42 C48,42 58,68 75,68"
        android:strokeWidth="4.5"
        android:strokeColor="#4FD1C5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
